# Copy to paths.env; edit paths for your machine before use. No credentials belong here.
export LINGBOT_ROOT=/root/lingbot_challenge
export CONDA_EXE=/home/vipuser/miniconda3/bin/conda
export LINGBOT_ENV="$LINGBOT_ROOT/envs/lingbotvla"
export ROBOTWIN_ENV="$LINGBOT_ROOT/envs/robotwin"
export HF_HOME="$LINGBOT_ROOT/cache/huggingface"
export XDG_CACHE_HOME="$LINGBOT_ROOT/cache/xdg"
export PIP_CACHE_DIR="$LINGBOT_ROOT/cache/pip"
export CONDA_PKGS_DIRS="$LINGBOT_ROOT/cache/conda"
export TORCH_HOME="$LINGBOT_ROOT/cache/torch"
export TORCH_EXTENSIONS_DIR="$LINGBOT_ROOT/cache/torch_extensions"
export TMPDIR="$LINGBOT_ROOT/cache/tmp"
export PYTHONNOUSERSITE=1
export PIP_NO_INPUT=1
export MAX_JOBS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
# If using a separate data disk, set its actual mount point and UUID.
export LINGBOT_STORAGE_MOUNT=
export LINGBOT_STORAGE_UUID=
