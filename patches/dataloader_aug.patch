+@lru_cache(maxsize=4)
+def seen_index(root):
+    """Validate ALL clean episodes before any instruction replacement."""
+    import pandas as pd
+    root = safe_path(root)
+    result = {}
+    manifests = sorted((root / 'configs').glob('clean_episodes_*.manifest.json'))
+    for manifest in manifests:
+        data = json.loads(manifest.read_text())
+        task = data['tasks'][0]
+        episodes = data['episodes']
+        if len(episodes) != 50 or {e['episode'] for e in episodes} != set(range(50)):
+            raise ValueError(f'Incomplete manifest: {task}')
+        repo = root / 'data/clean_processed/lerobot' / task
+        prov = json.loads((repo / 'conversion_provenance.json').read_text())
+        candidates = [manifest, root / 'configs/clean_episodes.manifest.json']
+        matched = [p for p in candidates if p.is_file() and hashlib.sha256(p.read_bytes()).hexdigest() == prov['input_manifest_sha256']]
+        if not matched or prov.get('instruction_field') != 'seen' or prov.get('sample_only'):
+            raise ValueError(f'Unverified conversion: {task}')
+        source = [e for e in json.loads(matched[0].read_text())['episodes'] if e['task'] == task]
+        if source != episodes:
+            raise ValueError(f'Manifest disagreement: {task}')
+        files = sorted((repo / 'meta/episodes').rglob('*.parquet'))
+        metadata = pd.concat([pd.read_parquet(p, columns=['episode_index', 'tasks']) for p in files])
+        if len(metadata) != 50 or set(metadata.episode_index) != set(range(50)):
+            raise ValueError(f'Incomplete LeRobot episodes: {task}')
+        metadata = metadata.set_index('episode_index')
+        for e in episodes:
+            raw = safe_path(root / e['instructions_path']).read_bytes()
+            if hashlib.sha256(raw).hexdigest() != e['instructions_sha256']:
+                raise ValueError(f'Seen SHA mismatch: {task}/{e["episode"]}')
+            obj = json.loads(raw)
+            if set(obj) != {'seen'} or not obj['seen'] or not all(isinstance(x, str) for x in obj['seen']):
+                raise ValueError('Instruction JSON must contain only a nonempty seen list')
+            prompts = list(metadata.loc[e['episode'], 'tasks'])
+            if len(prompts) != 1 or prompts[0] not in obj['seen']:
+                raise ValueError(f'Episode mapping mismatch: {task}/{e["episode"]}')
+            result[(str(repo.resolve()), e['episode'])] = (obj['seen'], str(safe_path(root / e['path'])), task)
+    if len(manifests) != 50 or len(result) != 2500:
+        raise ValueError('All 50 tasks / 2500 trajectories must be validated')
+    return result
+
