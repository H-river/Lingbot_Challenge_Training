+"""Deterministic CPU-only augmentation; no simulator or evaluation data access."""
+from functools import lru_cache
+from pathlib import Path
+import hashlib
+import json
+import math
+import os
+
+import cv2
+import numpy as np
+import torch
+from PIL import Image, ImageEnhance, ImageFilter
+
+
+BRIGHTNESS = (0.75, 1.1)
+CONTRAST = (0.6, 1.4)
+SATURATION = (0.5, 1.5)
+SHADOW_AWARE_CAMERAS = ('camera_top',)
+
+
+def safe_path(path):
+    p = Path(path).expanduser().resolve()
+    if 'unseen' in p.parts:
+        raise ValueError('unseen assets are forbidden')
+    return p
+
+
+def sample_rng(seed, epoch, index, stream='sample'):
+    digest = hashlib.sha256(f'{int(seed)}:{int(epoch)}:{int(index)}:{stream}'.encode()).digest()
+    return np.random.default_rng(int.from_bytes(digest[:8], 'little'))
+
+
+def enabled(config, policy_eval=False):
+    profile = config.get('profile', 'none')
+    if profile not in ('none', 'v1', 'v2'):
+        raise ValueError(f'Unknown aug.profile: {profile}')
+    return not policy_eval and profile != 'none'
+
+
+def uint8_hwc(tensor):
+    return tensor.detach().cpu().numpy().transpose(1, 2, 0).astype(np.uint8)
+
+
+def tensor_image(array, reference):
+    return torch.from_numpy(np.ascontiguousarray(array.transpose(2, 0, 1))).to(reference)
+
