+def estimate_colors(image):
+    """Spatially seeded robust modes; conservative masks are reviewed offline."""
+    h, w = image.shape[:2]
+    colors = {}
+    for name, region in [('table', image[h//2:]), ('wall', image[:max(1,h//12)])]:
+        bins = (region.reshape(-1, 3).astype(np.int32) // 12)
+        keys, counts = np.unique(bins, axis=0, return_counts=True)
+        mode = keys[counts.argmax()]
+        pixels = region.reshape(-1, 3)[np.all(bins == mode, axis=1)]
+        colors[name] = np.median(pixels, axis=0)
+    return colors
+
+
+def region_mask(image, color, tolerance=18, background_only=True):
+    return _region_mask(image.shape, image.tobytes(), tuple(float(x) for x in color), tolerance, background_only).copy()
+
+
+@lru_cache(maxsize=128)
+def _region_mask(shape, pixels, color, tolerance, background_only):
+    image = np.frombuffer(pixels, dtype=np.uint8).reshape(shape)
+    color = np.asarray(color)
+    distance = np.linalg.norm(image.astype(np.float32) - color, axis=-1)
+    raw = (distance < tolerance).astype(np.uint8)
+    kernel = np.ones((3, 3), np.uint8)
+    mask = cv2.morphologyEx(raw, cv2.MORPH_OPEN, kernel)
+    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)
+    # Closed object reflections must not become background. Separate boundaries
+    # before connected-component filtering, then demand broad frame contact.
+    if background_only:
+        mask *= raw
+        edges = cv2.Canny(cv2.cvtColor(image, cv2.COLOR_RGB2GRAY), 30, 80)
+        mask[cv2.dilate(edges, kernel) > 0] = 0
+    n, labels, stats, _ = cv2.connectedComponentsWithStats(mask)
+    out = np.zeros_like(mask)
+    for i in range(1, n):
+        component = labels == i
+        contacts = [int(component[0].sum()), int(component[-1].sum()), int(component[:,0].sum()), int(component[:,-1].sum())]
+        if (stats[i, cv2.CC_STAT_AREA] >= image.shape[0]*image.shape[1]*0.04
+                and (not background_only or (sum(c > 0 for c in contacts) >= 2
+                and sum(contacts) >= .05 * (2*image.shape[0]+2*image.shape[1])))):
+            out[component] = 1
+    # Closing must never add protected object pixels; erode for a safety margin.
+    return cv2.erode(out * raw, kernel).astype(bool)
+
+
+def shadow_region_mask(image, color, lo=0.5, hi=1.08, chroma_tol=0.035, canny=(60, 150), min_seed=20):
+    """Conservative mask grown into shadows of the same surface.
+
+    A shadow is the surface colour at lower brightness: same chromaticity, luminance
+    ratio in [lo, hi]. Candidate shadow regions are split only at HARD edges (object
+    outlines), so soft shadow boundaries do not separate a shadow from the lit surface.
+    A candidate component is accepted only if it overlaps the conservative mask, i.e.
+    it is connected to confirmed lit surface. Grey/metal objects enclosed by hard
+    edges form separate components with no overlap and are never textured.
+    """
+    return _shadow_region_mask(image.shape, image.tobytes(), tuple(float(x) for x in color),
+                               lo, hi, chroma_tol, tuple(canny), min_seed).copy()
+
+
+@lru_cache(maxsize=128)
+def _shadow_region_mask(shape, pixels, color, lo, hi, chroma_tol, canny, min_seed):
+    image = np.frombuffer(pixels, dtype=np.uint8).reshape(shape)
+    strict = region_mask(image, color)
+    img = image.astype(np.float32)
+    color = np.asarray(color, np.float32)
+    chroma = img / np.maximum(img.sum(-1, keepdims=True), 1)
+    ratio = img.mean(-1) / max(float(color.mean()), 1)
+    raw = ((np.linalg.norm(chroma - color / max(float(color.sum()), 1), axis=-1) < chroma_tol)
+           & (ratio > lo) & (ratio < hi)).astype(np.uint8)
+    kernel = np.ones((3, 3), np.uint8)
+    cand = cv2.morphologyEx(cv2.morphologyEx(raw, cv2.MORPH_OPEN, kernel), cv2.MORPH_CLOSE, kernel) * raw
+    hard = cv2.Canny(cv2.cvtColor(image, cv2.COLOR_RGB2GRAY), *canny)
+    cand[cv2.dilate(hard, kernel) > 0] = 0
+    n, labels = cv2.connectedComponents(cand)
+    if n <= 1:
+        return strict
+    overlap = np.bincount(labels[strict], minlength=n)
+    keep = overlap >= min_seed
+    keep[0] = False
+    grown = cv2.erode((keep[labels] & raw.astype(bool)).astype(np.uint8), kernel).astype(bool)
+    return strict | grown
+
+
+def fill_seam(table, wall, image, colors, band=14, tolerance=60):
+    """Assign the untextured band between wall and table masks to the nearer surface.
+
+    The band comes from edge removal + erosion at the wall/table boundary. Only pixels
+    lying BETWEEN the masks (d_table + d_wall <= 2*band, i.e. seams up to ~2*band wide)
+    and colour-close to one of the surfaces are filled; arms and objects (far from both
+    colours) are untouched.
+    """
+    if not table.any() or not wall.any():
+        return table, wall
+    d_table = cv2.distanceTransform((~table).astype(np.uint8), cv2.DIST_L2, 3)
+    d_wall = cv2.distanceTransform((~wall).astype(np.uint8), cv2.DIST_L2, 3)
+    gap = (d_table + d_wall <= 2 * band) & ~table & ~wall
+    if not gap.any():
+        return table, wall
+    img = image.astype(np.float32)
+    close = ((np.linalg.norm(img - np.asarray(colors['table'], np.float32), axis=-1) < tolerance)
+             | (np.linalg.norm(img - np.asarray(colors['wall'], np.float32), axis=-1) < tolerance))
+    gap &= close
+    to_table = gap & (d_table <= d_wall)
+    return table | to_table, wall | (gap & ~to_table)
+
+
+@lru_cache(maxsize=256)
+def episode_colors(raw_path):
+    import h5py
+    names = {'camera_top': 'head_camera', 'camera_wrist_left': 'left_camera', 'camera_wrist_right': 'right_camera'}
+    colors = {}
+    with h5py.File(safe_path(raw_path), 'r') as h:
+        for camera, source in names.items():
+            frame = cv2.imdecode(np.frombuffer(h[f'observation/{source}/rgb'][0], np.uint8), cv2.IMREAD_COLOR)
+            if frame is None:
+                raise ValueError('Undecodable release frame')
+            colors[camera] = estimate_colors(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
+    return colors
+
+
+def geometry(image, params):
+    h, w = image.shape[:2]
+    side, x, y, dx, dy = params
+    ch, cw = max(1, round(h*side)), max(1, round(w*side))
+    top, left = round(y*(h-ch)), round(x*(w-cw))
+    cropped = cv2.resize(image[top:top+ch, left:left+cw], (w,h), interpolation=cv2.INTER_LINEAR)
+    return cv2.warpAffine(cropped, np.float32([[1,0,dx*w],[0,1,dy*h]]), (w,h), borderMode=cv2.BORDER_REFLECT_101)
+
+
+def perlin_noise(rng, size=256, cells=8):
+    angles=rng.uniform(0,2*np.pi,(cells+1,cells+1))
+    gradients=np.stack((np.cos(angles),np.sin(angles)),axis=-1)
+    y,x=np.mgrid[:size,:size].astype(np.float32)*cells/size
+    ix,iy=x.astype(int),y.astype(int);fx,fy=x-ix,y-iy
+    u=fx**3*(fx*(fx*6-15)+10);v=fy**3*(fy*(fy*6-15)+10)
+    def dot(dx,dy):
+        g=gradients[iy+dy,ix+dx]
+        return g[...,0]*(fx-dx)+g[...,1]*(fy-dy)
+    return ((1-v)*((1-u)*dot(0,0)+u*dot(1,0))+v*((1-u)*dot(0,1)+u*dot(1,1))).astype(np.float32)
+
+
+def procedural_texture(rng, size=256):
+    y, x = np.mgrid[:size,:size].astype(np.float32)/size
+    kind = int(rng.integers(8))
+    noise = cv2.resize(rng.random((16,16)).astype(np.float32), (size,size), interpolation=cv2.INTER_CUBIC)
+    patterns = [np.sin(x*70+noise*8), np.sin((x+y)*25+noise*10),
+                np.sin(x*200)*np.sin(y*200), ((x*8)%1>.08)*((y*8)%1>.08),
+                np.sin(x*60), (np.floor(x*8)+np.floor(y*8))%2, perlin_noise(rng,size),
+                cv2.resize(rng.random((4,4)).astype(np.float32),(size,size),interpolation=cv2.INTER_NEAREST)*2-1]
+    base = rng.uniform(100,220,3)
+    return np.clip(base+patterns[kind][...,None]*rng.uniform(15,55),0,255).astype(np.uint8)
+
+
+@lru_cache(maxsize=8)
+def texture_files(directory):
+    root = safe_path(directory)
+    if root.name != 'seen':
+        raise ValueError('robotwin_seen requires the seen directory itself')
+    paths = []
+    for p in sorted(root.iterdir()):
+        p = safe_path(p)  # reject symlink escape into unseen BEFORE opening
+        if p.is_file() and p.suffix.lower() in ('.png','.jpg','.jpeg'):
+            paths.append(str(p))
+    if not paths:
+        raise ValueError('No seen textures')
+    return tuple(paths)
+
+
+@lru_cache(maxsize=64)
+def read_texture(path):
+    with Image.open(safe_path(path)) as im:
+        return np.asarray(im.convert('RGB').resize((256,256))).copy()
+
+
+# ---------------------------------------------------------------------------
+# ORACLE control experiment ONLY (V3). Adds the EVALUATION texture folder to the
+# texture pool to measure how much of the clean->random gap is explained by
+# texture distribution. A model trained this way has seen test-set assets and
+# must NEVER be submitted. Everything else (instructions, distractors, any other
+# path) still goes through safe_path() and keeps rejecting 'unseen'.
+# ---------------------------------------------------------------------------
+ORACLE_SOURCE = 'robotwin_seen_plus_unseen_ORACLE'
+ORACLE_ENV = 'LINGBOT_UNSEEN_TEXTURE_ORACLE'
+ORACLE_TOKEN = 'NOT_FOR_SUBMISSION'
+
+
+def require_oracle_opt_in():
+    if os.environ.get(ORACLE_ENV) != ORACLE_TOKEN:
+        raise PermissionError(f'{ORACLE_SOURCE} reads evaluation textures; set {ORACLE_ENV}={ORACLE_TOKEN} '
+                              'only for the non-submitted control experiment')
+
+
+@lru_cache(maxsize=2)
+def oracle_unseen_files(directory):
+    require_oracle_opt_in()
+    root = Path(directory).expanduser().resolve()
+    if root.name != 'unseen' or root.parent.name != 'background_texture':
+        raise ValueError('oracle source requires .../background_texture/unseen itself')
+    paths = []
+    for p in sorted(root.iterdir()):
+        p = p.resolve()
+        if not p.is_relative_to(root):
+            raise ValueError('symlink escape from unseen texture directory')
+        if p.is_file() and p.suffix.lower() in ('.png','.jpg','.jpeg'):
+            paths.append(str(p))
+    if not paths:
+        raise ValueError('No unseen textures')
+    import logging
+    logging.getLogger(__name__).warning('ORACLE: %d evaluation textures added to the pool; checkpoint is NOT FOR SUBMISSION', len(paths))
+    return tuple(paths)
+
+
+@lru_cache(maxsize=64)
+def read_oracle_texture(path):
+    require_oracle_opt_in()
+    with Image.open(path) as im:
+        return np.asarray(im.convert('RGB').resize((256,256))).copy()
+
+
+def make_texture(config, rng):
+    source = config.get('source', 'procedural')
+    if source == 'procedural':
+        tile = procedural_texture(rng)
+    elif source == 'robotwin_seen':
+        paths = texture_files(config['seen_dir'])
+        tile = read_texture(paths[int(rng.integers(len(paths)))])
+    elif source == ORACLE_SOURCE:
+        # Uniform over the union, same single RNG draw as robotwin_seen, so V2 and V3
+        # share every other random decision for the same sample.
+        seen, unseen = texture_files(config['seen_dir']), oracle_unseen_files(config['unseen_dir'])
+        k = int(rng.integers(len(seen) + len(unseen)))
+        tile = read_texture(seen[k]) if k < len(seen) else read_oracle_texture(unseen[k - len(seen)])
+    else:
+        raise ValueError('Unsupported texture source')
+    tile = np.rot90(tile, int(rng.integers(4)))
+    size = int(rng.integers(64,257))
+    tile = cv2.resize(tile, (size,size))
+    return np.tile(tile, (math.ceil(256/size),math.ceil(256/size),1))[:256,:256]
+
+
+def color_image(image, params, noise_seed):
+    b,c,s,hue,noise,blur = params
+    im = Image.fromarray(image)
+    for cls, factor in [(ImageEnhance.Brightness,b),(ImageEnhance.Contrast,c),(ImageEnhance.Color,s)]:
+        im = cls(im).enhance(factor)
+    hsv = np.array(im.convert('HSV'))
+    hsv[...,0] = (hsv[...,0].astype(np.int32)+hue)%256
+    im = Image.fromarray(hsv, 'HSV').convert('RGB').filter(ImageFilter.GaussianBlur(blur))
+    arr = np.asarray(im).astype(np.float32)
+    arr += np.random.default_rng(noise_seed).normal(0,noise,arr.shape)
+    return np.clip(arr,0,255).astype(np.uint8)
+
+
+class SampleAugment:
+    def __init__(self, config, seed, epoch, index, raw_path, task):
+        self.config, self.task = config, task
+        for operation in ('color','geometric','texture','distractor'):
+            probability=config.get(operation,{}).get('p',.5 if operation=='color' else .3)
+            if not 0 <= probability <= 1:
+                raise ValueError(f'{operation}.p must be in [0,1]')
+        if config.get('profile') == 'v2' and config.get('texture',{}).get('source') == 'robotwin_seen':
+            texture_files(config['texture']['seen_dir'])
+        if config.get('texture',{}).get('source') == ORACLE_SOURCE:
+            if config.get('profile') != 'v2':
+                raise ValueError('oracle texture source is only defined for profile v2')
+            texture_files(config['texture']['seen_dir']); oracle_unseen_files(config['texture']['unseen_dir'])
+        self._key = (seed, epoch, index)
+        self.idle_arm = None
+        self.rng = sample_rng(seed,epoch,index)
+        self.noise_seed = int(sample_rng(seed,epoch,index,'noise').integers(2**32))
+        self.state_rng = sample_rng(seed,epoch,index,'state')
+        self.raw_path = raw_path
+        self.geom = None
+        self.color = None
+        self.textures = {}
+        self.placements = {}
+        rng = self.rng
+        g, c = config.get('geometric',{}), config.get('color',{})
+        if rng.random() < g.get('p',.3):
+            self.geom = (math.sqrt(rng.uniform(g.get('min_area',.9),1)),rng.random(),rng.random(),*rng.uniform(-g.get('max_shift',.04),g.get('max_shift',.04),2))
+        if rng.random() < c.get('p',.5):
+            # RoboTwin clean scenes are near-white, so brightness above ~1.1 clips large regions.
+            (b0,b1),(c0,c1),(s0,s1) = (c.get('brightness',BRIGHTNESS),c.get('contrast',CONTRAST),c.get('saturation',SATURATION))
+            self.color = (rng.uniform(b0,b1),rng.uniform(c0,c1),rng.uniform(s0,s1),int(rng.integers(-4,5)),rng.uniform(0,2),rng.uniform(0,.5))
+        # Every operation gets its own Bernoulli decision, including inactive V1 operations.
+        tc, dc = config.get('texture',{}), config.get('distractor',{})
+        texture_on, self.distractor_on = rng.random() < tc.get('p',.3), rng.random() < dc.get('p',.3)
+        if config['profile'] == 'v2' and texture_on:
+            self.textures = {region:make_texture(tc,rng) for region in tc.get('regions',['table','wall'])}
+        self.distractor_on &= config['profile'] == 'v2'
+        if not config.get('teacher_uses_clean',True):
+            raise ValueError('This pipeline requires geometry-only teachers')
+
+    def surface_masks(self, camera, image, colors):
+        """Table/wall masks; shadow-aware on configured cameras, conservative elsewhere."""
+        tc = self.config.get('texture', {})
+        shadow = camera in tc.get('shadow_aware_cameras', SHADOW_AWARE_CAMERAS)
+        masks = {region: (shadow_region_mask if shadow else region_mask)(image, color)
+                 for region, color in colors.items()}
+        if (tc.get('fill_seam', True) and 'table' in masks and 'wall' in masks
+                and np.linalg.norm(np.asarray(colors['wall']) - np.asarray(colors['table'])) >= 24):
+            masks['table'], masks['wall'] = fill_seam(masks['table'], masks['wall'], image, colors)
+        return masks
+
+    def observe_actions(self, item):
+        """Called with the normalized per-feature action chunk before padding (V2b idle-arm focus)."""
+        dc = self.config.get('distractor', {})
+        if self.config.get('profile') == 'v2' and dc.get('placement', 'v1') == 'v2b':
+            self.idle_arm = detect_idle_arm(item, dc.get('idle_arm', {}))
+
+    def v2b_enabled(self):
+        return (self.config.get('texture', {}).get('mode', 'mask') == 'overlay'
+                or self.config.get('distractor', {}).get('placement', 'v1') == 'v2b')
+
+    def apply_pair(self, current, future=None):
+        if self.v2b_enabled():
+            return self._apply_pair_v2b(current, future)
+        students, teachers, future_students, future_teachers = {},{},{},{}
+        colors = episode_colors(self.raw_path) if self.textures or self.distractor_on else {}
+        for camera, tensor in current.items():
+            images = [uint8_hwc(tensor)]
+            if future and camera in future:
+                images.append(uint8_hwc(future[camera]))
+            masks = [self.surface_masks(camera, im, colors.get(camera, {})) for im in images]
+            dc = self.config.get("distractor",{})
+            placements = plan_distractors(dc,self.task,masks,self.rng) if self.distractor_on and camera in dc.get("cameras",["camera_top"]) else []
+            for i,im in enumerate(images):
+                teacher = geometry(im,self.geom) if self.geom else im.copy()
+                student = im.copy()
+                for region, texture in self.textures.items():
+                    mask = masks[i][region]
+                    # Do not invent wall/table separation when their colors coincide.
+                    if region == 'wall' and np.linalg.norm(colors[camera]['wall']-colors[camera]['table']) < 24:
+                        continue
+                    alpha = cv2.GaussianBlur(mask.astype(np.float32),(0,0),1)*mask
+                    tex = cv2.resize(texture,(im.shape[1],im.shape[0])).astype(np.float32)
+                    illumination = im.mean(-1,keepdims=True)/max(1,float(colors[camera][region].mean()))
+                    student = np.clip(student*(1-alpha[...,None])+tex*illumination*alpha[...,None],0,255).astype(np.uint8)
+                student = paste_distractors(student,placements)
+                if self.geom:
+                    student = geometry(student,self.geom)
+                if self.color:
+                    student = color_image(student,self.color,self.noise_seed)
+                a,b = (students,teachers) if i==0 else (future_students,future_teachers)
+                a[camera],b[camera] = tensor_image(student,tensor),tensor_image(teacher,tensor)
+        return students,teachers,future_students,future_teachers
+
+    def _apply_pair_v2b(self, current, future=None):
+        """V2b path. Texture: 'mask' (as before) or 'overlay' (segmentation-free).
+        Distractors: 'v1' (head only) or 'v2b' (all cameras, near objects, idle-arm focus,
+        contact shadow). Order for overlay: distractors -> texture overlay (so pasted objects
+        are textured like real ones) -> geometry -> colour. Teacher: geometry only."""
+        tc, dc = self.config.get('texture', {}), self.config.get('distractor', {})
+        overlay = tc.get('mode', 'mask') == 'overlay'
+        v2b_place = dc.get('placement', 'v1') == 'v2b'
+        focus = None
+        if v2b_place and self.config.get('profile') == 'v2' and self.idle_arm is not None:
+            if sample_rng(*self._key, 'idle').random() < dc.get('idle_focus_p', 0.0):
+                focus = self.idle_arm
+        distract = self.distractor_on or focus is not None
+        need_colors = distract or (self.textures and not overlay)
+        colors = episode_colors(self.raw_path) if need_colors else {}
+        if focus is not None:
+            cameras = {HEAD_CAMERA, WRIST_CAMERAS[focus]}
+        else:
+            cameras = set(dc.get('cameras', [HEAD_CAMERA]))
+        students, teachers, future_students, future_teachers = {}, {}, {}, {}
+        for camera, tensor in current.items():
+            images = [uint8_hwc(tensor)]
+            if future and camera in future:
+                images.append(uint8_hwc(future[camera]))
+            cam_colors = colors.get(camera, {})
+            surf = [self.surface_masks(camera, im, cam_colors) for im in images] if (self.textures and not overlay) else None
+            placements = []
+            if distract and camera in cameras and 'table' in cam_colors:
+                if v2b_place:
+                    table = [region_mask(im, cam_colors['table']) for im in images]
+                    placements = plan_distractors_v2b(dc, self.task, camera, table, images[0],
+                                                      sample_rng(*self._key, f'distractor:{camera}'), focus)
+                else:
+                    masks = surf or [{'table': region_mask(im, cam_colors['table'])} for im in images]
+                    placements = plan_distractors(dc, self.task, masks, self.rng)
+            ov = overlay_params(sample_rng(*self._key, f'overlay:{camera}'), camera, tc.get('overlay', {})) \
+                if (self.textures and overlay) else None
+            for i, im in enumerate(images):
+                teacher = geometry(im, self.geom) if self.geom else im.copy()
+                student = im.copy()
+                if surf is not None:
+                    for region, texture in self.textures.items():
+                        if region not in surf[i]:
+                            continue
+                        if region == 'wall' and np.linalg.norm(cam_colors['wall'] - cam_colors['table']) < 24:
+                            continue
+                        mask = surf[i][region]
+                        alpha = cv2.GaussianBlur(mask.astype(np.float32), (0, 0), 1) * mask
+                        tex = cv2.resize(texture, (im.shape[1], im.shape[0])).astype(np.float32)
+                        illumination = im.mean(-1, keepdims=True) / max(1, float(cam_colors[region].mean()))
+                        student = np.clip(student * (1 - alpha[..., None]) + tex * illumination * alpha[..., None], 0, 255).astype(np.uint8)
+                if v2b_place:
+                    student = paste_distractors_v2b(student, placements)
+                else:
+                    student = paste_distractors(student, [p[:3] for p in placements])
+                if ov is not None:
+                    student = overlay_texture(student, self.textures, ov)
+                if self.geom:
+                    student = geometry(student, self.geom)
+                if self.color:
+                    student = color_image(student, self.color, self.noise_seed)
+                a, b = (students, teachers) if i == 0 else (future_students, future_teachers)
+                a[camera], b[camera] = tensor_image(student, tensor), tensor_image(teacher, tensor)
+        return students, teachers, future_students, future_teachers
+
+    def perturb_state(self,state):
+        config = self.config.get('state_noise',{})
+        if not config.get('enabled',False):
+            return state
+        noise = self.state_rng.normal(0,config.get('std',0),tuple(state.shape))
+        return state+torch.as_tensor(noise,dtype=state.dtype,device=state.device)
+
+
+@lru_cache(maxsize=4)
+def distractor_library(directory):
+    root = safe_path(directory)
+    manifest = json.loads((root/'manifest.json').read_text())
+    if manifest.get('source') != 'release_clean_first_head_frames':
+        raise ValueError('Unapproved distractor library source')
+    for entry in manifest['items']:
+        path = safe_path(root/entry['file'])
+        if not path.is_relative_to(root) or hashlib.sha256(path.read_bytes()).hexdigest() != entry['sha256']:
+            raise ValueError('Distractor path/hash mismatch')
+    return root,manifest['items']
+
+
+@lru_cache(maxsize=128)
+def read_cutout(path):
+    with Image.open(safe_path(path)) as im:
+        return np.array(im.convert('RGBA'))
+
+
+def plan_distractors(config, task, masks, rng):
+    root, library = distractor_library(config['library_dir'])
+    candidates = [e for e in library if e['task'] != task]
+    if not candidates:
+        return []
+    allowed = np.logical_and.reduce([m['table'] for m in masks])
+    allowed = cv2.erode(allowed.astype(np.uint8),np.ones((7,7),np.uint8)).astype(bool)
+    h,w = allowed.shape
+    placements = []
+    for _ in range(int(rng.integers(1,config.get('max_count',3)+1))):
+        entry = candidates[int(rng.integers(len(candidates)))]
+        patch = read_cutout(str(root/entry['file']))
+        scale = rng.uniform(.5,1.2)*w/320
+        pw,ph = max(2,round(patch.shape[1]*scale)),max(2,round(patch.shape[0]*scale))
+        if pw >= w or ph >= h:
+            continue
+        patch = cv2.resize(patch,(pw,ph))
+        if rng.random()<.5:
+            patch = patch[:,::-1].copy()
+        support = patch[...,3]>0
+        for _ in range(config.get('max_retries',20)):
+            x,y = int(rng.integers(w-pw)),int(rng.integers(h-ph))
+            roi = allowed[y:y+ph,x:x+pw]
+            if support.any() and np.all(roi[support]):
+                placements.append((x,y,patch))
+                roi[support] = False
+                break
+    return placements
+
+
+def paste_distractors(image, placements):
+    image = image.copy()
+    for x,y,patch in placements:
+        h,w = patch.shape[:2]; a = patch[...,3:4].astype(np.float32)/255
+        roi=image[y:y+h,x:x+w]
+        image[y:y+h,x:x+w]=np.clip(roi*(1-a)+patch[...,:3]*a,0,255).astype(np.uint8)
+    return image
+
+
+# ---------------------------------------------------------------------------
+# V2b: segmentation-free texture overlay + shortcut-breaking distractors.
+# Motivation (observed in evaluation): the clean-trained policy learned
+# "non-white thing in front of the gripper => move/grasp". These samples show
+# textures and extra objects in front of the robot while the demonstrated action
+# (the label) ignores them, so presence of objects/texture stops predicting motion.
+# ---------------------------------------------------------------------------
+HEAD_CAMERA = 'camera_top'
+WRIST_CAMERAS = {'left': 'camera_wrist_left', 'right': 'camera_wrist_right'}
+
+
+def overlay_params(rng, camera, oc):
+    """Per-camera random wall/table split line and blend strength (no segmentation)."""
+    alpha = float(rng.uniform(*oc.get('alpha', (0.2, 0.5))))
+    tilt = float(np.deg2rad(rng.uniform(-oc.get('tilt_deg', 5), oc.get('tilt_deg', 5))))
+    if camera == HEAD_CAMERA:
+        y0 = float(rng.uniform(*oc.get('head_line', (0.05, 0.35))))
+    elif rng.random() < oc.get('wrist_wall_p', 0.3):
+        y0 = float(rng.uniform(*oc.get('wrist_line', (0.0, 0.5))))
+    else:
+        y0 = None                                   # wrist view usually sees only table
+    return y0, tilt, alpha, float(oc.get('feather', 3))
+
+
+def overlay_texture(image, textures, params):
+    """Blend a wall texture above a random line and a table texture below it over the
+    WHOLE image. Texture is modulated by the image's own luminance so shading, edges
+    and objects stay visible: out = (1-a)*img + a*tex*lum."""
+    y0, tilt, alpha, feather = params
+    h, w = image.shape[:2]
+    table = textures.get('table', next(iter(textures.values())))
+    tex = cv2.resize(table, (w, h)).astype(np.float32)
+    if y0 is not None and 'wall' in textures:
+        wall = cv2.resize(textures['wall'], (w, h)).astype(np.float32)
+        yy, xx = np.mgrid[:h, :w].astype(np.float32)
+        boundary = y0 * h + np.tan(tilt) * (xx - w / 2)
+        above = 1.0 / (1.0 + np.exp(np.clip((yy - boundary) / max(feather, 1e-3), -50, 50)))
+        tex = above[..., None] * wall + (1 - above[..., None]) * tex
+    img = image.astype(np.float32)
+    lum = img.mean(-1, keepdims=True) / max(float(img.mean()), 1.0)
+    return np.clip((1 - alpha) * img + alpha * tex * lum, 0, 255).astype(np.uint8)
+
+
+def object_anchors(image, table_mask):
+    """Boundary pixels of coloured, non-table blobs (likely task objects; arms are mostly
+    achromatic) with the outward direction from their blob centroid. Boundary, not interior,
+    so 'near' placements land beside the object rather than on it."""
+    chroma = image.max(-1).astype(np.int16) - image.min(-1).astype(np.int16)
+    blob = ((chroma > 40) & (image.mean(-1) > 50) & ~table_mask).astype(np.uint8)
+    edge = blob.astype(bool) & ~cv2.erode(blob, np.ones((3, 3), np.uint8)).astype(bool)
+    _, labels, _, centroids = cv2.connectedComponentsWithStats(blob)
+    points = np.argwhere(edge)
+    if len(points) == 0:
+        return points, np.zeros(0)
+    cx, cy = centroids[labels[points[:, 0], points[:, 1]]].T
+    outward = np.arctan2(points[:, 0] - cy, points[:, 1] - cx)
+    return points, outward
+
+
+def plan_distractors_v2b(config, task, camera, masks, image, rng, focus=None):
+    """Distractors on any configured camera. Optional placement near existing objects
+    (hard negatives) and, under idle-arm focus, inside the idle arm's half of the head view."""
+    root, library = distractor_library(config['library_dir'])
+    candidates = [e for e in library if e['task'] != task]
+    if not candidates or not masks:
+        return []
+    allowed = np.logical_and.reduce([m for m in masks])
+    allowed = cv2.erode(allowed.astype(np.uint8), np.ones((7, 7), np.uint8)).astype(bool)
+    h, w = allowed.shape
+    if focus is not None and camera == HEAD_CAMERA:
+        side = np.zeros_like(allowed)
+        side[:, :w // 2] = focus == 'left'
+        side[:, w // 2:] = focus == 'right'
+        allowed &= side
+    anchors, outward = object_anchors(image, masks[0])
+    lo, hi = (1.0, 1.0) if camera == HEAD_CAMERA else tuple(config.get('wrist_scale', (1.5, 3.0)))
+    placements = []
+    for _ in range(int(rng.integers(1, config.get('max_count', 4) + 1))):
+        entry = candidates[int(rng.integers(len(candidates)))]
+        source = read_cutout(str(root / entry['file']))
+        base = rng.uniform(.5, 1.2) * w / 320 * rng.uniform(lo, hi)
+        flip = rng.random() < .5
+        near = len(anchors) > 0 and rng.random() < config.get('near_object_p', 0.5)
+        shadow = float(rng.uniform(.25, .45)) if config.get('shadow', True) else 0.0
+        retries = config.get('max_retries', 20)
+        placed = False
+        # Free table area is small in close-up wrist views: retry at 70% and 50% size.
+        for shrink in (1.0, 0.7, 0.5):
+            pw, ph = max(2, round(source.shape[1] * base * shrink)), max(2, round(source.shape[0] * base * shrink))
+            if pw >= w or ph >= h:
+                continue
+            patch = cv2.resize(source, (pw, ph))
+            if flip:
+                patch = patch[:, ::-1].copy()
+            support = patch[..., 3] > 0
+            for _ in range(max(1, retries // 3)):
+                if near:
+                    k = int(rng.integers(len(anchors)))
+                    ay, ax = anchors[k]
+                    # outward from the object (+-90 deg); +4 px clears the 3 px erosion margin
+                    angle = outward[k] + rng.uniform(-np.pi / 2, np.pi / 2)
+                    dist = rng.uniform(.6, 1.5) * max(pw, ph) + 4
+                    x, y = int(ax + dist * np.cos(angle) - pw / 2), int(ay + dist * np.sin(angle) - ph / 2)
+                    if x < 0 or y < 0 or x + pw > w or y + ph > h:
+                        continue
+                else:
+                    x, y = int(rng.integers(w - pw)), int(rng.integers(h - ph))
+                roi = allowed[y:y + ph, x:x + pw]
+                if support.any() and np.all(roi[support]):
+                    placements.append((x, y, patch, shadow))
+                    roi[support] = False
+                    placed = True
+                    break
+            if placed:
+                break
+    return placements
+
+
+def paste_distractors_v2b(image, placements):
+    """Paste cutouts with a soft contact shadow so 'floating sticker' is not a cue."""
+    out = image.astype(np.float32)
+    H, W = out.shape[:2]
+    for x, y, patch, shadow in placements:
+        h, w = patch.shape[:2]
+        if shadow > 0:
+            m = np.zeros((H, W), np.float32)
+            cv2.ellipse(m, (int(x + w / 2), int(y + h * 0.92)), (max(1, int(w * 0.5)), max(1, int(h * 0.18))), 0, 0, 360, 1.0, -1)
+            m = cv2.GaussianBlur(m, (0, 0), max(1.0, h * 0.08))
+            out *= (1 - shadow * m)[..., None]
+        a = patch[..., 3:4].astype(np.float32) / 255
+        roi = out[y:y + h, x:x + w]
+        out[y:y + h, x:x + w] = roi * (1 - a) + patch[..., :3] * a
+    return np.clip(out, 0, 255).astype(np.uint8)
+
+
+def detect_idle_arm(item, config):
+    """'left'/'right' if exactly one arm (joints + gripper) stays still over the valid
+    part of the action chunk, else None. Uses normalized release actions only."""
+    arm = item.get(config.get('arm_key', 'action.arm.position'))
+    grip = item.get(config.get('gripper_key', 'action.effector.position'))
+    if arm is None or grip is None:
+        return None
+    arm, grip = torch.as_tensor(arm).float(), torch.as_tensor(grip).float()
+    pad = item.get('action_is_pad')
+    if pad is not None:
+        valid = ~torch.as_tensor(pad).bool()
+        arm, grip = arm[valid], grip[valid]
+    if arm.ndim != 2 or arm.shape[0] < 2 or grip.ndim != 2 or grip.shape[-1] < 2:
+        return None
+    thr, half = float(config.get('threshold', 0.05)), arm.shape[-1] // 2
+
+    def still(joints, gripper):
+        return bool((joints - joints[0]).abs().max() < thr and (gripper - gripper[0]).abs().max() < thr)
+
+    left, right = still(arm[:, :half], grip[:, 0]), still(arm[:, half:], grip[:, 1])
+    return 'left' if left and not right else 'right' if right and not left else None
